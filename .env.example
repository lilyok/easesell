# Google Cloud Vision Web Detection. The key stays on this service.
# https://console.cloud.google.com/apis/library/vision.googleapis.com
GOOGLE_CLOUD_VISION_API_KEY=

# Must match the iPhone app bundle id.
APPLE_BUNDLE_ID=app.easesell.ios

# Signs the session token. Required in production.
SESSION_SECRET=

# Simulator only. Lets the iPhone app sign in without an Apple developer team,
# and accepts StoreKit test receipts. Never set this in production.
# EASESELL_DEV_AUTH=1

# Names a photo as "Sample item" when the Vision key is empty.
# VISION_STUB=1
