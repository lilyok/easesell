# Google Lens reverse image search via SerpAPI.
# Without this key, a demo catalog is used and the photo is not actually searched.
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Facebook Marketplace (optional — mock used when unset)
NEXT_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:43127/api/marketplace/callback
